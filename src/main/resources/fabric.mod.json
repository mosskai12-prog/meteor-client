{
  "schemaVersion": 1,
  "id": "fizzy",
  "version": "${version}",
  "name": "Fizzy Client",
  "description": "Fizzy Client for Minecraft 1.21.11, based on Aoba Client source.",
  "authors": ["Fizzy contributors", "Aoba Client contributors"],
  "contact": {
    "sources": "https://github.com/mosskai12-prog/meteor-client",
    "issues": "https://github.com/mosskai12-prog/meteor-client/issues",
    "upstream": "https://github.com/Cocolots/Aoba-Client"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/aoba/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["net.aoba.Aoba"]
  },
  "mixins": [
    "aoba.mixins.json",
    "aoba-sodium.mixins.json"
  ],
  "accessWidener": "aoba.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*"
  }
}
